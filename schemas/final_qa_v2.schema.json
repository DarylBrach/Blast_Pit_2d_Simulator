{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adlerbaer.local/schemas/final_qa_v2.schema.json",
  "title": "Codex Improvement Final QA v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diff_sha256", "verdict", "criteria", "finding_dispositions", "blockers", "warnings", "recommendation"],
  "properties": {
    "schema_version": {"type": "string", "const": "codex.final-qa.v2"},
    "diff_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "verdict": {"type": "string", "enum": ["PASS", "CHANGES_REQUIRED", "BLOCK"]},
    "criteria": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/criterion"}},
    "finding_dispositions": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/disposition"}},
    "blockers": {"$ref": "#/$defs/texts"},
    "warnings": {"$ref": "#/$defs/texts"},
    "recommendation": {"type": "string", "minLength": 1, "maxLength": 2000}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 1500},
    "texts": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/text"}},
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "pass", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$"},
        "pass": {"type": "boolean"},
        "evidence": {"$ref": "#/$defs/text"}
      }
    },
    "disposition": {
      "type": "object", "additionalProperties": false,
      "required": ["finding_id", "status", "evidence"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}-[0-9]{3}$", "maxLength": 36},
        "status": {"type": "string", "enum": ["RESOLVED", "NOT_APPLICABLE", "UNRESOLVED", "ACCEPTED_RISK"]},
        "evidence": {"$ref": "#/$defs/text"}
      }
    }
  }
}
